# Configuration d'environnement pour le `user-service`
# Copiez ce fichier en `.env.local` ou définissez les variables dans votre IDE / terminal.

# ===== SERVER =====
SERVER_PORT=8079

# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=plansync_db_user
DB_USERNAME=root
DB_PASSWORD=

# ===== EMAIL (SMTP / Gmail) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sabriboussami@gmail.com
MAIL_PASSWORD=sdodbhmedcjwojnu

# ===== APPLICATION =====
APP_FRONTEND_URL=http://localhost:4200

# ===== EUREKA (Service Discovery) =====
EUREKA_HOST=localhost
